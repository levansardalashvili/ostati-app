# Copy this file to `.env` and fill in real values from your Supabase
# project (Project Settings -> API). `.env` is gitignored and must never
# be committed. Only EXPO_PUBLIC_-prefixed values reach the client bundle
# (that prefix is Expo's own convention for "safe to expose publicly") —
# never put a service_role key, DB password, or any other admin secret
# in a variable with this prefix, or in this project at all on the
# client side.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
